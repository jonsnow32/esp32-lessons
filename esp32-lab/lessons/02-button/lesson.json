      "type": "esp32-devkit-v1",
      "x": 1,
      "y": 3
    },
    "breadboards": [
      {
        "id": "bb1",
        "type": "half-400",
        "x": 15,
        "y": 6
      }
    ],
    "parts": [
      {
        "id": "r1",
        "type": "resistor",
        "props": {
          "resistance": 220
        },
        "placement": {
          "bb": "bb1",
          "hole": "a5",
          "rot": 0
        }
      },
      {
        "id": "led1",
        "type": "led",
        "props": {
          "color": "red"
        },
        "placement": {
          "bb": "bb1",
          "hole": "e9",
          "rot": 0
        }
      }
    ],
    "wires": [
      {
        "id": "w1",
        "a": {
          "kind": "board",
          "pin": "D2"
        },
        "b": {
          "kind": "hole",
          "bb": "bb1",
          "hole": "e5"
        },
        "color": "#f5d90a"
      },
      {
        "id": "w2",
        "a": {
          "kind": "hole",
          "bb": "bb1",
          "hole": "a10"
        },
        "b": {
          "kind": "hole",
          "bb": "bb1",
          "hole": "tn9"
        },
        "color": "#1c2024"
      },
      {
        "id": "w3",
        "a": {
          "kind": "board",
          "pin": "GND.R"
        },
        "b": {
          "kind": "hole",
          "bb": "bb1",
          "hole": "tn1"
        },
        "color": "#1c2024"
      }
    ],
    "firmware": {
      "kind": "pio-env",
      "env": "lesson02"
    },
    "lessonId": "02-button",
    "seed": 1
  },
  "steps": [
    {
      "id": "wiring",
      "title": "BOOT pulls GPIO0 to GND",
      "checks": [
        {
          "kind": "series",
          "from": {
            "pad": "GPIO0"
          },
          "through": [
            {
              "type": "pushbutton"
            }
          ],
          "to": {
            "net": "GND"
          }
        }
      ],
      "hint": "On the DevKit the BOOT button is already wired between GPIO0 and GND, with a 10 k\u03a9 pull-up."
    },
    {
      "id": "press",
      "title": "Press BOOT: the LED toggles once per press",
      "checks": [
        {
          "kind": "serialMatches",
          "pattern": "Press #1 -> LED ON"
        }
      ],
      "hint": "Set DEBOUNCE_MS to 0 and press a few times: contact bounce gives you several counts per press."
    },
    {
      "id": "external-led-d2",
      "title": "Each BOOT press also toggles an external LED on D2",
      "checks": [
        {
          "kind": "series",
          "from": {
            "pad": "GPIO2"
          },
          "through": [
            {
              "type": "resistor"
            },
            {
              "type": "led",
              "enter": "anode",
              "exit": "cathode"
            }
          ],
          "to": {
            "net": "GND"
          },
          "order": "any"
        },
        {
          "kind": "noShort",
          "nets": [
            "3V3",
            "5V"
          ]
        }
      ],
      "hint": "Same LED circuit as lesson 01; the firmware drives GPIO2 for both LEDs."
    }
  ],
  "exercises": [
    {
      "id": "external-button",
      "title": "Add your own button on D18 using INPUT_PULLUP",
      "checks": [
        {
          "kind": "series",
          "from": {
            "pad": "GPIO18"
          },
          "through": [
            {
              "type": "pushbutton"
            }
          ],
          "to": {
            "net": "GND"
          }
        },
        {
          "kind": "avoidPads",
          "pads": [
            "GPIO34",
            "GPIO35",
            "GPIO36",
            "GPIO39"
          ],
          "reason": "input-only pins have no internal pull-up"
        },
        {
          "kind": "noShort",
          "nets": [
            "3V3",
            "5V"
          ]
        }
      ],
      "hint": "Put the button across the middle gap; one leg to D18, the other leg's column to the blue (\u2212) rail, and the rail to GND.",
