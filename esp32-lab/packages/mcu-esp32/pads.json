      "strapping": true,
      "adc": "ADC2_CH2",
      "adcBlockedByWifi": true,
      "touch": "T2",
      "note": "Strapping: must be LOW/floating to enter download mode; onboard LED"
    },
    "GPIO3": {
      "inputOnly": false,
      "pullResistors": true,
      "flash": false,
      "strapping": false,
      "note": "UART0 RX \u2013 used by USB Serial"
