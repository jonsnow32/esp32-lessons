{
  "mcu": "esp32",
  "pads": {
    "GPIO0": {
      "inputOnly": false,
      "pullResistors": true,
      "flash": false,
      "strapping": true,
      "adc": "ADC2_CH1",
      "adcBlockedByWifi": true,
      "touch": "T1",
      "note": "Strapping: LOW at reset enters download mode (BOOT button)"
    },
    "GPIO1": {
      "inputOnly": false,
      "pullResistors": true,
      "flash": false,
      "strapping": false,
      "note": "UART0 TX \u2013 used by USB Serial"
