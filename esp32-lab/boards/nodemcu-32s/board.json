      "id": "led",
      "type": "led",
      "label": "Blue LED (GPIO2)",
      "props": {
        "color": "blue"
      },
      "connect": {
        "anode": {
          "node": "led_a"
        },
        "cathode": {
          "net": "GND"
        }
      },
      "x": 5.5,
      "y": 19.2
    },
    {
      "id": "r_led",
      "type": "resistor",
      "props": {
        "resistance": 1000
      },
      "connect": {
        "a": {
          "pad": "GPIO2"
        },
        "b": {
          "node": "led_a"
        }
      }
    },
    {
