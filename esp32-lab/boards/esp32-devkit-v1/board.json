  ],
  "supplies": [
    {
      "name": "USB VBUS",
      "net": "5V",
      "volts": 5.0,
      "rOut": 0.3,
      "currentMax": 0.5
    },
    {
      "name": "AMS1117-3.3",
      "net": "3V3",
      "volts": 3.3,
      "rOut": 0.1,
      "currentMax": 0.8
    }
  ],
  "onboard": [
    {
      "id": "led",
      "type": "led",
      "label": "Blue LED (GPIO2)",
      "props": {
        "color": "blue"
      },
      "connect": {
        "anode": {
          "node": "led_a"
        },
        "cathode": {
          "net": "GND"
        }
      },
      "x": 5.5,
      "y": 15.2
    },
    {
      "id": "r_led",
      "type": "resistor",
      "props": {
        "resistance": 1000
      },
      "connect": {
        "a": {
          "pad": "GPIO2"
        },
        "b": {
          "node": "led_a"
        }
      }
    },
    {
      "id": "r_boot",
      "type": "resistor",
      "label": "GPIO0 pull-up",
      "props": {
        "resistance": 10000
      },
      "connect": {
        "a": {
          "net": "3V3"
        },
        "b": {
          "pad": "GPIO0"
        }
      }
    },
    {
      "id": "boot",
      "type": "pushbutton",
      "label": "BOOT",
      "connect": {
        "a1": {
          "pad": "GPIO0"
        },
        "b1": {
          "net": "GND"
        }
      },
      "x": 8.3,
      "y": 16.6
    },
    {
      "id": "r_en",
      "type": "resistor",
      "label": "EN pull-up",
      "props": {
        "resistance": 10000
      },
      "connect": {
        "a": {
          "net": "3V3"
        },
        "b": {
          "pad": "EN"
        }
      }
    },
    {
      "id": "en",
      "type": "pushbutton",
      "label": "EN (reset)",
      "connect": {
        "a1": {
          "pad": "EN"
        },
        "b1": {
          "net": "GND"
        }
      },
      "x": 1.7,
      "y": 16.6
    }
  ]
}